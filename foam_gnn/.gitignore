# --- foam_gnn (self-contained) ---

# Datasets are loaded from a configurable directory at runtime; never commit raw data.
# (The 5 small sample frames under tests/fixtures/ ARE committed on purpose, for smoke tests.)
data/
!tests/fixtures/
!tests/fixtures/**

# Training artifacts
checkpoints/
runs/
*.pt
*.ckpt
wandb/

# Scratch / QC outputs
dev/
qc/
*.tmp

# Colab upload package: bulk data (frame PNGs) regenerable via build_colab_package.py
# from gitignored data/ + committed groundtruth/. The builder script is tracked (it
# lives at the project root, alongside label.py); this output is not.
colab_package/

# Generated CSV deliverables (data products derived from gitignored data/).
# The format doc lives in export_csv.py (_README) and is regenerated as
# exports/README_csv.md by the exporter.
exports/

# Ground-truth labeling: tolabel/ (raw frame exports) and preseed/ (cached automatic
# pre-seed segmentations) are both REGENERABLE from gitignored data/ (dev/export_
# label_frames.py, dev/preseed_labels.py). The hand-corrected labels themselves
# (groundtruth/<set>/<exp>/*.png) + manifest.csv (provenance) ARE committed — they
# are the actual research artifact and its audit trail.
groundtruth/tolabel/
groundtruth/preseed/
groundtruth/manifest_template.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
